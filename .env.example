TMDB_READ_ACCESS_TOKEN=
FRONTEND_ORIGIN=http://localhost:5173
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=64

# Proyecto Supabase con firma ES256 para el Gateway
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Gateway fuera de Docker; Compose usa automáticamente http://library-service:3002
LIBRARY_ORIGIN=http://127.0.0.1:3002
RECOMMENDATIONS_CACHE_TTL_MS=120000

# Conexión de Library Service
DATABASE_URL=

# Conexión para migraciones de Prisma
DIRECT_URL=

# Detección de expresiones (AWS Rekognition). Sin AWS_REGION el análisis responde 503.
# El SDK usa su cadena estándar de credenciales. Las claves siguientes solo son necesarias
# cuando el entorno no proporciona un rol, perfil u otro proveedor de credenciales.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
EMOTION_AWS_TIMEOUT_MS=5000
# Umbral de producto, no de AWS: por debajo no se sugiere una expresión.
EMOTION_MIN_CONFIDENCE=30
# Límite por usuario autenticado.
EMOTION_ANALYZE_LIMIT=10
EMOTION_ANALYZE_WINDOW_MS=60000

# Prueba opcional de PostgreSQL con rollback (perfil propio existente).
# No son necesarias para ejecutar los servicios ni las pruebas simuladas.
LIBRARY_TEST_DATABASE_URL=
LIBRARY_TEST_PROFILE_ID=
